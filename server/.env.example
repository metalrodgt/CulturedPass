# ===== Servidor =====
PORT=3000
NODE_ENV=development
# URL del frontend (Vite). Se usa para CORS.
CLIENT_URL=http://localhost:5173
# Zona horaria para decidir cuándo un evento "ya finalizó" y si una fecha es pasada
TIMEZONE=America/Argentina/Buenos_Aires

# ===== Base de datos (Supabase) =====
# Supabase > botón "Connect" > "Transaction pooler" (puerto 6543).
# Si tu contraseña tiene caracteres especiales (@ # / : ?) hay que codificarlos (ej: @ = %40)
DATABASE_URL="postgresql://postgres.TU_PROJECT_REF:TU_PASSWORD@aws-0-TU_REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5"

# ===== JWT =====
# Mínimo 32 caracteres. Generar uno con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_HORAS=8

# ===== Correo (opcional en desarrollo) =====
# Si SMTP_USER o SMTP_PASS están vacíos, los correos NO se envían: se muestran en la consola.
# Para Gmail: usar una "contraseña de aplicación" (requiere verificación en 2 pasos).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="CulturedPass <tu_correo@gmail.com>"

# ===== Cancelación de inscripciones =====
CANCEL_MAX_INTENTOS=3
CANCEL_COOLDOWN_MINUTOS=15

# ===== Primer administrador (solo para: npm run crear-admin) =====
# Bórralos del .env una vez creado el administrador.
ADMIN_NOMBRE=
ADMIN_GMAIL=
ADMIN_TEL=
ADMIN_PASSWORD=
